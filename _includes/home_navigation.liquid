<a class="home-skip-link" href="#about">Skip to content</a>
<header class="home-masthead">
  <nav class="home-nav" aria-label="Main navigation">
    <a class="home-wordmark" href="{{ '/' | relative_url }}">Boyuan An<span aria-hidden="true">.</span></a>
    <div class="home-nav-links">
      <a href="#about">About</a>
      {% if page.selected_papers -%}
        <a href="#publications">Publications</a>
      {%- endif %}
      {% if page.selected_projects -%}
        <a href="#projects">Projects</a>
      {%- endif %}
      {% if site.enable_darkmode %}
        <button id="light-toggle" type="button" title="Change theme" aria-label="Change color theme">
          <i class="ti ti-sun-moon" id="light-toggle-system" aria-hidden="true"></i>
          <i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i>
          <i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
        </button>
      {% endif %}
    </div>
  </nav>
</header>
